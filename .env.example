# Public site URL (used for canonical links and the sitemap)
NEXT_PUBLIC_SITE_URL=https://taomiq.uz

# Supabase project (Settings → API). Until these are set the site shows demo data
# and the admin shows a "database not connected" page.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key (Settings → API → Secret keys). Never prefix with NEXT_PUBLIC_.
# Used only to submit orders; until it is set the order form says "ordering opens soon".
SUPABASE_SECRET_KEY=

# Customer sign-in on the public site: a comma list of telegram, google, email (shown in that order).
# Empty or unset turns it off: no login link anywhere, and /login, /account and /auth/callback are not served.
# Each method also needs its provider switched on in Supabase (Authentication → Sign In / Providers):
#   telegram → custom OIDC provider "custom:telegram" (issuer https://oauth.telegram.org, scopes openid profile phone)
#   google   → the built-in Google provider
#   email    → Email with a 6-digit code template ({{ .Token }}) and custom SMTP
# Supabase → Authentication → URL Configuration must allow <site URL>/auth/callback** as a redirect URL.
# The sign-in callback stores the Telegram phone with SUPABASE_SECRET_KEY (above).
NEXT_PUBLIC_AUTH_METHODS=

# Back-office Google sign-in (server-only): "on" shows "Sign in with Google" on the admin login; anything else
# hides it, and the start action and admin-host /auth/callback refuse. Separate from NEXT_PUBLIC_AUTH_METHODS, so
# staff can use Google before customer accounts open. Google never grants access by itself: the person still needs
# a staff row, and Supabase links Google to an existing user only when the email matches and is confirmed. Setup:
#   Google Cloud → OAuth client (Web application), authorised redirect URI <Supabase URL>/auth/v1/callback;
#     consent screen External, scopes openid email profile
#   Supabase → Authentication → Providers → Google: client ID and client secret, enabled
#   Supabase → Authentication → URL Configuration: allow https://admin.taomiq.uz/auth/callback and
#     http://admin.localhost:5555/auth/callback
ADMIN_GOOGLE_LOGIN=

# Cloudflare Turnstile bot check (Cloudflare dashboard → Turnstile → add a widget, Managed mode, hostnames
# taomiq.uz and admin.taomiq.uz only; never add localhost to the production widget). Both empty: no widget and no
# check. Only one set counts as both empty (the server logs a warning): set them together.
# The order form is checked on our server with the secret key; a token solved on any other host is refused. The
# email-code form and the back-office login hand the token to Supabase: switch on Supabase → Authentication →
# Attack Protection → CAPTCHA (Turnstile, same secret key) only after these are live, and never with either empty,
# or those sign-ins stop working.
# Local testing: use Cloudflare's test keys with `npm run dev` (site 1x00000000000000000000AA, secret
# 1x0000000000000000000000000000000AA). Their tokens name the host example.com and no action, which only
# `npm run dev` accepts; every build refuses them.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: Telegram alert to the staff chat on each new order (no customer name or phone in it).
# Create a bot with @BotFather, add it to the staff chat, put the chat id here. Leave empty to turn off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_STAFF_CHAT_ID=

# Product analytics: PostHog, EU cloud (Frankfurt). The project API key (phc_…, PostHog → Project settings → Project
# API key) is public by design: it ships to every browser. Set it in Vercel for Production only, never Preview or
# Development. Empty or unset: PostHog is off, nothing loads and no request is made (local dev, demo mode, e2e).
# The browser sends to taomiq.uz/k7r2, which next.config.ts forwards to PostHog; never loaded on the admin host.
NEXT_PUBLIC_POSTHOG_KEY=
